# Maven publish env — used by publish-to-github-pages.sh and by
# .github/workflows/build-lexbor-android-release.yml
#
# Set these in the workflow (or export before running the script):
#   MAVEN_VERSION  — e.g. 3.0.0-1 (from ANDROID_RELEASE_TAG, e.g. lexbor-android-v3.0.0-1 -> 3.0.0-1)
#   AAR_SRC        — path to the built AAR, e.g. lexbor-3.0.0-1.aar (relative to workspace root when script runs)
#   MAVEN_REPO_PAT — GitHub PAT with push access to the Maven repo (e.g. XDcobra/maven)
#
# Fixed values for this artifact:

GROUP_ID=com.xdcobra.sherpa
ARTIFACT_ID=lexbor
